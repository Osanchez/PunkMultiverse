<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PunkMultiverse</AssemblyName>
    <RootNamespace>PunkMultiverse</RootNamespace>
    <Version>0.1.255</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- The mod's sources ALL live in src/. Default SDK globbing would compile every .cs
         anywhere under the project dir — which silently swallowed the 776-file decompiled
         game tree under gamescan/cache/ (424 errors). Whitelist src/ instead of blacklisting
         each new folder, so nothing added later can poison the build. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Class libraries don't copy NuGet assemblies to bin by default; we need LiteNetLib.dll
         in the output so build.ps1 can deploy it next to the plugin. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- This folder lives inside the game install; override with -p:GameDir= for CI. -->
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildProjectDirectory)\..</GameDir>
    <ManagedDir>$(GameDir)\Punk_Data\Managed</ManagedDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <!-- Paired with EnableDefaultCompileItems=false above. -->
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- LiteNetLib: the "Udp" transport (Docker/LAN/no-Steam). Pure netstandard UDP with
         reliable-ordered channels. MERGED into PunkMultiverse.dll post-build (see the
         MergeLiteNetLib target) so the release is a single DLL; Internalize hides its types
         from other mods, so a second copy elsewhere can never conflict. -->
    <PackageReference Include="LiteNetLib" Version="1.2.0" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34.2" PrivateAssets="all" />
  </ItemGroup>

  <!-- Single-DLL packaging lives in ILRepack.targets (project root): the ILRepack.Lib package
       imports that file INSTEAD of running its default merge-everything-in-place target (which
       lacks our LibraryPath and fails on the BepInEx references). -->

  <ItemGroup>
    <Reference Include="BepInEx.Core">      <HintPath>$(BepInExCore)\BepInEx.Core.dll</HintPath>       <Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.Mono"><HintPath>$(BepInExCore)\BepInEx.Unity.Mono.dll</HintPath> <Private>false</Private></Reference>
    <Reference Include="0Harmony">          <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>           <Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Punk.Main">                  <HintPath>$(ManagedDir)\Punk.Main.dll</HintPath>                   <Private>false</Private></Reference>
    <Reference Include="ServiceLocator">             <HintPath>$(ManagedDir)\ServiceLocator.dll</HintPath>              <Private>false</Private></Reference>
    <Reference Include="com.rlabrecque.steamworks.net"><HintPath>$(ManagedDir)\com.rlabrecque.steamworks.net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UniTask">                    <HintPath>$(ManagedDir)\UniTask.dll</HintPath>                     <Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization">      <HintPath>$(ManagedDir)\Sirenix.Serialization.dll</HintPath>       <Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization.Config"><HintPath>$(ManagedDir)\Sirenix.Serialization.Config.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem">          <HintPath>$(ManagedDir)\Unity.InputSystem.dll</HintPath>           <Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics">          <HintPath>$(ManagedDir)\Unity.Mathematics.dll</HintPath>           <Private>false</Private></Reference>
    <Reference Include="Unity.Collections">          <HintPath>$(ManagedDir)\Unity.Collections.dll</HintPath>          <Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro">          <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>           <Private>false</Private></Reference>
    <Reference Include="UnityEngine">                <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>                 <Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule">     <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>      <Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI">             <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>              <Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule">       <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>        <Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule">    <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>     <Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(ManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <!-- Texture2D.EncodeToPNG, for the `dumpsprites` devcmd: exporting the game's own sprites so
         custom art can be authored against the real palette rather than an approximation. -->
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <!-- ScreenCapture, for the `screenshot` devcmd: the game photographs its own framebuffer, which
         is the only capture route that cannot pick up anything else on the desktop. -->
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(ManagedDir)\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule">   <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>    <Private>false</Private></Reference>
    <Reference Include="UnityEngine.Physics2DModule"><HintPath>$(ManagedDir)\UnityEngine.Physics2DModule.dll</HintPath> <Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath> <Private>false</Private></Reference>
    <Reference Include="ProCamera2D.Runtime">       <HintPath>$(ManagedDir)\ProCamera2D.Runtime.dll</HintPath>          <Private>false</Private></Reference>
  </ItemGroup>

  <!-- A protocol bump must move the version with it. Before CoreCompile so it fails fast, and
       on the MSBuild side rather than inside build.ps1 so a bare `dotnet build` is covered too.
       See src/Protocol/protocol.lock for what it enforces and why. -->
  <Target Name="CheckProtocolLock" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\protocol-lock.ps1&quot; -Version $(Version)" />
  </Target>

  <!-- Plugin.Version (and the BepInPlugin attribute) must be a compile-time const, so the
       csproj <Version> is baked into a generated source file. Single source of truth: the
       pre-commit bump now propagates to the handshake, lobby data, and update check. -->
  <Target Name="GeneratePluginVersion" BeforeTargets="CoreCompile">
    <ItemGroup>
      <PluginVersionLine Include="// Generated by the GeneratePluginVersion target from the csproj &lt;Version&gt; — do not edit." />
      <PluginVersionLine Include="namespace PunkMultiverse" />
      <PluginVersionLine Include="{" />
      <PluginVersionLine Include="    internal static class PluginVersionInfo" />
      <PluginVersionLine Include="    {" />
      <PluginVersionLine Include="        public const string Version = &quot;$(Version)&quot;%3b" />
      <PluginVersionLine Include="    }" />
      <PluginVersionLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)PluginVersionInfo.cs" Lines="@(PluginVersionLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)PluginVersionInfo.cs" />
    </ItemGroup>
  </Target>

</Project>
